# Normalmente esto viene de Doppler. Este archivo es solo para `bun run dev:local`.

# Puerto del servidor
PORT=3000

# Origenes permitidos (coma separada). * en desarrollo.
CORS_ORIGIN=*

# URL https del proyecto de Supabase (NO la cadena postgresql://). Con esto se verifican los JWT de la app.
SUPABASE_URL=https://eotdzgsisxfqyqbxwqna.supabase.co

# Solo si el proyecto usa JWT legacy (HS256): Supabase → Project Settings → JWT Keys → Legacy JWT secret.
# SUPABASE_JWT_SECRET=

# Descripción de productos con IA. Clave de Google AI Studio (https://aistudio.google.com/apikey).
# GEMINI_API_KEY=
# IA_MODELO=gemini-3.5-flash
# IA_MAX_SALIDA=400
# Necesaria también para la cuota de IA (y para crear empleados).
# SUPABASE_SERVICE_ROLE_KEY=

# Bloqueo por tokens inválidos: cuántos fallos por IP y por cuántos minutos.
# AUTH_MAX_FALLOS=10
# AUTH_BLOQUEO_MIN=15
