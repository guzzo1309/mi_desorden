{
  "name": "api",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "doppler run -- bun --watch src/server.ts",
    "dev:local": "bun --watch src/server.ts",
    "start": "doppler run -- bun src/server.ts",
    "build": "bun build src/serverless.ts --target node --format cjs --outdir dist --sourcemap=linked --external @nestjs/microservices --external @nestjs/websockets --external @nestjs/websockets/socket-module --external @nestjs/microservices/microservices-module --external class-transformer/storage --external swagger-ui-dist",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "clean": "rm -rf dist node_modules .turbo"
  },
  "dependencies": {
    "@mi-desorden/core": "workspace:*",
    "@nestjs/common": "^11",
    "@nestjs/config": "^4",
    "@nestjs/core": "^11",
    "@nestjs/platform-express": "^11",
    "@nestjs/swagger": "^11",
    "@nestjs/throttler": "^6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11",
    "@types/bun": "latest",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "typescript": "~5.9.2"
  }
}
