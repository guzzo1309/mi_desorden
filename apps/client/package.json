{
  "name": "client",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "doppler run --mount .env -- expo start -c",
    "ios": "doppler run -- expo run:ios",
    "android": "doppler run -- expo run:android",
    "web": "doppler run --mount .env -- expo start --web -c",
    "build": "expo export",
    "dev:local": "expo start",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .expo dist node_modules .turbo",
    "test": "bun test api lib"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@expo/ui": "~58.0.25",
    "@expo/vector-icons": "^15.0.2",
    "@mi-desorden/core": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.62.0",
    "expo": "^58.0.0",
    "expo-blur": "~58.0.5",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.14",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.28",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "fflate": "^0.8.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/bun": "^1.4.2",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.0",
    "typescript": "~6.0.3"
  },
  "expo": {
    "autolinking": {
      "searchPaths": [
        "../../node_modules",
        "node_modules"
      ]
