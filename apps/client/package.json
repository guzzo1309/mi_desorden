{
  "name": "client",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "doppler run --mount .env -- expo start -c",
    "ios": "doppler run -- expo run:ios",
    "android": "doppler run -- expo run:android",
    "web": "doppler run --mount .env -- expo start --web -c",
    "build": "expo export",
    "dev:local": "expo start",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .expo dist node_modules .turbo",
    "test": "bun test api lib"
  },
  "dependencies": {
    "@expo/ui": "~57.0.21",
    "@expo/vector-icons": "^15.0.2",
    "@mi-desorden/core": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.62.0",
    "expo": "^57.0.0",
    "expo-blur": "~57.0.3",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.20",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-glass-effect": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "fflate": "^0.8.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/bun": "^1.4.2",
    "@types/react": "~19.2.4",
    "babel-preset-expo": "~57.0.0",
    "typescript": "~6.0.3"
  },
  "expo": {
    "autolinking": {
      "searchPaths": [
        "../../node_modules",
        "node_modules"
      ]
    }
