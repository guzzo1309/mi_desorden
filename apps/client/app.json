{
  "expo": {
    "name": "Mi desorden",
    "slug": "mi-desorden",
    "scheme": "midesorden",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icono.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "dev.rgtech.midesorden",
      "supportsTablet": true,
      "appleTeamId": "KXT5H89TYR"
    },
    "android": {
      "package": "dev.rgtech.midesorden",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icono-android.png",
        "backgroundColor": "#F2A33A"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Mi desorden usa la cámara para reconocer tus productos por su foto y su etiqueta. Todo pasa en el teléfono.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Mi desorden usa tus fotos para leer los productos de una factura."
        }
      ],
      "expo-status-bar",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "output": "single"
    }
  }
}
