{
  "expo": {
    "name": "mi_desorden",
    "slug": "mi-desorden",
    "scheme": "midesorden",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "dev.rgtech.midesorden",
      "supportsTablet": true
    },
    "android": {
      "package": "dev.rgtech.midesorden"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "mi_desorden usa la cámara para reconocer los productos de tu estantería.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
