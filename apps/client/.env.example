# Normalmente esto viene de Doppler (`doppler setup`). Este archivo es solo
# para correr sin Doppler con `bun run dev:local`.

# development | staging | production. Define qué URLs de API se permiten (api/permitidas.ts).
EXPO_PUBLIC_APP_ENV=development

# API local. En dispositivo físico usá la IP de tu máquina, no localhost.
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# Supabase → Project Settings → API Keys. Va la "publishable" (o la anon legacy),
# nunca la secret / service_role: esto termina dentro de la app.
EXPO_PUBLIC_SUPABASE_URL=https://eotdzgsisxfqyqbxwqna.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=
